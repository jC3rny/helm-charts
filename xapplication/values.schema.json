{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "anyMap": {"type": "object"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "portName": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,13}[a-z0-9])?$"},
    "dnsLabel": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "intOrPercent": {"type": ["integer", "string"], "pattern": "^[0-9]+%?$"},
    "quantity": {"type": ["string", "integer"]},
    "container": {"type": "object", "required": ["name", "image"], "properties": {"name": {"$ref": "#/definitions/dnsLabel"}, "image": {"type": "string"}}},
    "probe": {"type": ["object", "null"]}
  },
  "properties": {
    "global": {},
    "fullnameOverride": {"type": "string"},
    "nameOverride": {"type": "string"},
    "commonLabels": {"$ref": "#/definitions/stringMap"},
    "kind": {"enum": ["Deployment", "StatefulSet"]},
    "replicaCount": {"type": "integer", "minimum": 0},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0},
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["RollingUpdate", "Recreate", "OnDelete"]},
        "rollingUpdate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "maxSurge": {"$ref": "#/definitions/intOrPercent"},
            "maxUnavailable": {"$ref": "#/definitions/intOrPercent"},
            "partition": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "automountServiceAccountToken": {"type": "boolean"},
    "podSecurityContext": {"$ref": "#/definitions/anyMap"},
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"type": "string"}}}
    },
    "initContainers": {"type": "array", "items": {"$ref": "#/definitions/container"}},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "command": {"type": "array", "items": {"type": "string"}},
    "args": {"type": "array", "items": {"type": "string"}},
    "port": {"$ref": "#/definitions/port"},
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "port"],
        "additionalProperties": false,
        "properties": {
          "name": {"allOf": [{"$ref": "#/definitions/portName"}, {"not": {"const": "http"}}]},
          "port": {"$ref": "#/definitions/port"}
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "minProperties": 2,
        "maxProperties": 2,
        "properties": {
          "name": {"type": "string", "pattern": "^[-._a-zA-Z][-._a-zA-Z0-9]*$"},
          "value": {"type": ["string", "number", "boolean"]},
          "valueFrom": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "configMapKeyRef": {"$ref": "#/definitions/anyMap"},
              "secretKeyRef": {"$ref": "#/definitions/anyMap"},
              "fieldRef": {"$ref": "#/definitions/anyMap"},
              "resourceFieldRef": {"$ref": "#/definitions/anyMap"}
            }
          },
          "remoteRef": {"type": "object", "required": ["key"], "properties": {"key": {"type": "string"}}},
          "encryptedData": {"type": "string", "minLength": 1}
        }
      }
    },
    "envFrom": {"type": "array", "items": {"$ref": "#/definitions/anyMap"}},
    "resources": {"$ref": "#/definitions/anyMap"},
    "probes": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "readiness": {"$ref": "#/definitions/probe"},
        "liveness": {"$ref": "#/definitions/probe"},
        "startup": {"$ref": "#/definitions/probe"}
      }
    },
    "lifecycle": {"$ref": "#/definitions/anyMap"},
    "securityContext": {"$ref": "#/definitions/anyMap"},
    "sidecars": {"type": "array", "items": {"$ref": "#/definitions/container"}},
    "tmp": {
      "type": "object",
      "required": ["sizeLimit"],
      "additionalProperties": false,
      "properties": {"sizeLimit": {"$ref": "#/definitions/quantity"}}
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mountPath"],
        "additionalProperties": {"type": "object"},
        "properties": {
          "name": {"allOf": [{"$ref": "#/definitions/dnsLabel"}, {"not": {"const": "tmp"}}]},
          "mountPath": {"type": "string", "pattern": "^/"},
          "subPath": {"type": "string"},
          "readOnly": {"type": "boolean"},
          "persistentVolumeClaim": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "size": {"$ref": "#/definitions/quantity"},
              "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
              "storageClass": {"type": "string"},
              "keep": {"type": "boolean"},
              "claimName": {"type": "string"}
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "affinity": {"$ref": "#/definitions/anyMap"},
    "tolerations": {"type": "array", "items": {"$ref": "#/definitions/anyMap"}},
    "topologySpread": {
      "type": "array",
      "items": {"type": "object", "required": ["topologyKey"], "properties": {"topologyKey": {"type": "string"}}}
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"$ref": "#/definitions/port"},
        "annotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "extraServices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"$ref": "#/definitions/dnsLabel"},
          "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
          "clusterIP": {"type": "string"},
          "ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/portName"}},
          "publishNotReadyAddresses": {"type": "boolean"},
          "annotations": {"$ref": "#/definitions/stringMap"}
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "parentRefs": {"type": "array", "items": {"type": "object", "required": ["name"]}},
        "hostnames": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"$ref": "#/definitions/anyMap"}}
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1},
        "targetMemoryUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"$ref": "#/definitions/intOrPercent"},
        "maxUnavailable": {"anyOf": [{"$ref": "#/definitions/intOrPercent"}, {"type": "null"}]}
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": {"type": "string"},
            "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
          }
        },
        "replicaCount": {"type": "integer", "minimum": 1},
        "weight": {"type": "integer", "minimum": 0, "maximum": 100},
        "header": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["SecretStore", "ClusterSecretStore"]},
            "name": {"type": "string"}
          }
        },
        "refreshInterval": {"type": "string"}
      }
    },
    "sealedSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"scope": {"enum": ["strict", "namespace-wide", "cluster-wide"]}}
    },
    "reloader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"enum": ["ServiceMonitor", "PodMonitor"]},
        "interval": {"type": "string"},
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["port"],
            "additionalProperties": false,
            "properties": {
              "port": {"anyOf": [{"$ref": "#/definitions/port"}, {"$ref": "#/definitions/portName"}]},
              "path": {"type": "string", "pattern": "^/"},
              "interval": {"type": "string"}
            }
          }
        }
      }
    },
    "extraManifests": {"type": "array", "items": {"type": ["object", "string"]}}
  }
}
